#!/bin/sh
#
# Point Casks/sectile.rb at a Sectile release.
#
# Usage: bin/update-cask [vX.Y.Z]
#
# With no tag, the latest GitHub Release of sebastienferry/sectile. The
# checksums are read from that release's SHA256SUMS, never computed from a
# download, so the cask vouches for exactly what the release vouches for.
# Prints the version the cask now names; leaves the file untouched when it
# already names it. GITHUB_TOKEN, when set, authenticates the API call.
set -eu

repo=sebastienferry/sectile
cask=$(cd "$(dirname "$0")/.." && pwd)/Casks/sectile.rb

tag=${1:-}
if [ -z "$tag" ]; then
  auth=
  if [ -n "${GITHUB_TOKEN:-}" ]; then auth="Authorization: Bearer ${GITHUB_TOKEN}"; fi
  tag=$(curl -fsSL ${auth:+-H "$auth"} "https://api.github.com/repos/${repo}/releases/latest" |
    sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p')
fi
case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "not a release tag: '${tag}'" >&2; exit 1 ;;
esac
version=${tag#v}

sums=$(curl -fsSL "https://github.com/${repo}/releases/download/${tag}/SHA256SUMS") ||
  { echo "${tag} publishes no SHA256SUMS" >&2; exit 1; }
sum() {
  value=$(printf '%s\n' "$sums" | awk -v file="$1" '$2 == file { print $1 }')
  case "$value" in
    *[!0-9a-f]* | "") echo "${tag} has no checksum for $1" >&2; exit 1 ;;
  esac
  [ ${#value} -eq 64 ] || { echo "${tag} has a malformed checksum for $1" >&2; exit 1; }
  printf '%s' "$value"
}
arm=$(sum sectile-desktop-darwin-arm64.zip)
intel=$(sum sectile-desktop-darwin-amd64.zip)

tmp=${cask}.tmp
trap 'rm -f "$tmp"' EXIT
sed -E \
  -e "s/^(  version \")[^\"]*(\")/\1${version}\2/" \
  -e "s/^(  sha256 arm: +\")[0-9a-f]*(\")/\1${arm}\2/" \
  -e "s/^( +intel: \")[0-9a-f]*(\")/\1${intel}\2/" \
  "$cask" > "$tmp"

# Each of the three lines must have been found, or the cask changed shape
# under this script and would be published half-updated.
grep -q "^  version \"${version}\"" "$tmp" &&
  grep -q "\"${arm}\"" "$tmp" &&
  grep -q "\"${intel}\"" "$tmp" ||
  { echo "Casks/sectile.rb no longer has the lines this script rewrites" >&2; exit 1; }

if ! cmp -s "$tmp" "$cask"; then cat "$tmp" > "$cask"; fi
echo "$version"
